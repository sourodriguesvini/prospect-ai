{
  "extends": "@prospector/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "next.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
