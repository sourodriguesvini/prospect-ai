# Copie para apps/web/.env.local (nunca versionado). Lidas só pelo servidor do app.
# Nada com prefixo NEXT_PUBLIC_: nenhuma destas variáveis pode chegar ao navegador.
# Sem SUPABASE_URL e SUPABASE_SECRET_KEY o app abre e mostra "banco não configurado".

# Projeto Supabase de desenvolvimento: Project Settings → API (URL e uma secret key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Somente testes (nunca lida pela aplicação web) ---
# Postgres para `pnpm test:db` em modo real (sem ela, usa PGlite em memória). Nunca produção.
TEST_DATABASE_URL=

# --- IA local (Ollama, ADR-0008) — todas opcionais e nenhuma é segredo ---
# Endereço da API do Ollama; use só loopback. Padrão: http://127.0.0.1:11434
OLLAMA_BASE_URL=
# Modelos do Copiloto em ordem de preferência, separados por vírgula. Padrão: qwen3.5:4b (sem reserva automática)
AI_COPILOT_MODELS=
# Quanto tempo o modelo fica na GPU depois do último uso (ex.: 5m, 30s, 0). Padrão: 5m
AI_KEEP_ALIVE=
# Janela de contexto pedida ao Ollama (2048 a 262144); maior = mais VRAM. Padrão: 8192
AI_NUM_CTX=
# Respostas simultâneas (1 a 4). Padrão: 1
AI_MAX_CONCURRENCY=
# Pedidos esperando na fila (0 a 20); além disso o Copiloto responde "ocupado". Padrão: 3
AI_MAX_QUEUE=
# Memória de vídeo (MiB, 0 a 65536) que a IA local deixa livre para os outros programas: um
# modelo só carrega se, depois de carregado, sobrar ao menos isso. Padrão: 3072 (3 GB)
AI_VRAM_RESERVE_MIB=

# --- Consulta de CNPJ (M2) ---
# on (padrão: OpenCNPJ, com a Minha Receita de reserva, sem chave), off (uso sem internet) ou
# fixture (registros SINTÉTICOS, só com PROSPECTOR_STORAGE=memory; testes de ponta a ponta)
PROSPECTOR_CNPJ_LOOKUP=

# --- Pesquisa na internet (ADR-0012, D-AI-4) ---
# Chave da Tavily, plano gratuito (app.tavily.com → API Keys). Segredo: só neste arquivo.
# Sem ela, a busca responde "não configurada"; a leitura de páginas funciona sem chave.
TAVILY_API_KEY=
# off desliga a busca mesmo com chave. Padrão: ligada
PROSPECTOR_WEB_SEARCH=
# off desliga a leitura de páginas (Playwright). Padrão: ligada
PROSPECTOR_PAGE_READER=
# Créditos por mês que o app pode gastar (0 a 1000, a cota gratuita); ao chegar nele, as
# buscas param até o mês seguinte. Padrão: 900
WEB_SEARCH_MONTHLY_CREDITS=
# Buscas simultâneas (1 a 4). Padrão: 2
WEB_SEARCH_MAX_CONCURRENCY=
# Horas que uma busca idêntica é reaproveitada sem gastar crédito (0 a 720). Padrão: 24
WEB_SEARCH_CACHE_HOURS=
# Páginas lidas ao mesmo tempo (1 a 3). Padrão: 1
PAGE_READER_MAX_CONCURRENCY=
