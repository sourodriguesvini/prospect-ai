# Copie para apps/web/.env.local (nunca versionado). Valores do ambiente local: `supabase status`.
# Nada sensível com prefixo NEXT_PUBLIC_: a URL e a publishable key são públicas por desenho.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente testes (nunca lidas pela aplicação web) ---
# Secret key do Supabase LOCAL, usada pelo E2E completo para criar usuários de teste.
SUPABASE_SECRET_KEY=
# Postgres do Supabase local para `pnpm test:db` em modo real (sem ela, usa PGlite em memória).
TEST_DATABASE_URL=
